{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-doctor.local/schemas/v0/event/chain-template.schema.json",
  "title": "Expected event chain template v0",
  "description": "What a business flow is expected to look like, stage by stage (e.g. 'buy item': click -> POST /api/buy -> handler -> orders write -> response -> UI change). Gap assessment compares an assembled action against a template. A template proposed by AI or learned from traces is a hypothesis until a user confirms it, and absence relative to an unconfirmed template is never conclusive.",
  "type": "object",
  "required": ["cd_schema", "id", "version", "name", "source", "confirmed_by_user", "trigger", "stages"],
  "properties": {
    "cd_schema": { "const": "cd.event.chain-template/0" },
    "id": { "type": "string", "pattern": "^tpl:[a-z0-9][a-z0-9._-]{0,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 4096 },
    "source": { "enum": ["user", "inferred_from_code", "learned_from_traces", "agent_proposed"] },
    "confirmed_by_user": { "type": "boolean" },
    "trigger": {
      "description": "Which ui.action (or other root) starts this flow.",
      "$ref": "#/$defs/match"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "additionalProperties": false,
  "if": { "properties": { "source": { "const": "user" } } },
  "then": { "properties": { "confirmed_by_user": { "const": true } } },
  "$defs": {
    "match": {
      "type": "object",
      "required": ["cd_kind"],
      "properties": {
        "cd_kind": { "type": "string", "pattern": "^(ui\\.action|ui\\.settle|http\\.client|http\\.server|handler|db|ws\\.send|ws\\.recv|job\\.enqueue|job\\.run|other)$" },
        "service": { "$ref": "../common/defs.schema.json#/$defs/serviceName" },
        "attributes_equal": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_][a-z0-9_.\\-]{0,254}$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "attributes_prefix": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_][a-z0-9_.\\-]{0,254}$" },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["id", "layer", "match", "required", "deadline_ms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "layer": { "$ref": "../common/defs.schema.json#/$defs/layer" },
        "match": { "$ref": "#/$defs/match" },
        "required": {
          "description": "false for stages that legitimately may not happen (e.g. cache hit skips the db stage).",
          "type": "boolean"
        },
        "after": {
          "description": "Stage ids that must be present before this one is expected.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
        },
        "deadline_ms": {
          "description": "Maximum time after the action start by which the stage is expected to have ended.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
