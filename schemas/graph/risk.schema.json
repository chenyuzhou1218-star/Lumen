{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-doctor.local/schemas/v0/graph/risk.schema.json",
  "title": "Coupling risk finding v0",
  "description": "A deterministic detector found a structural pattern in the coupling graph that often leads to bugs. It is a lead, never a bug report: the logic head turns it into a risk_prediction claim (level speculated) with a falsification test, and only a test can make it a reproduced fact.",
  "type": "object",
  "required": ["cd_schema", "id", "pattern", "severity", "entities", "locations", "explanation", "fault_model", "how_to_verify", "code_version"],
  "properties": {
    "cd_schema": { "const": "cd.graph.risk/0" },
    "id": { "type": "string", "pattern": "^rsk_[0-9a-f]{16}$" },
    "pattern": {
      "enum": ["shared_state_multi_writer", "retry_path_to_write", "multi_write_without_transaction",
               "silent_noop_path", "event_without_listener", "listener_without_event", "client_route_without_handler"]
    },
    "severity": { "enum": ["low", "medium", "high"] },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "../claim/entity-ref.schema.json" } },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "line"],
        "properties": {
          "path": { "$ref": "../common/defs.schema.json#/$defs/repoPath" },
          "line": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "fault_model": { "type": "string", "pattern": "^fm:[a-z0-9_]{1,64}$" },
    "how_to_verify": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "code_version": { "$ref": "../common/defs.schema.json#/$defs/codeVersion" }
  },
  "additionalProperties": false
}
