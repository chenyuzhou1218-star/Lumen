{
  "description": "Every agent has its own user-chosen endpoint/model, including the same model on several agents.",
  "schema": "config/project.schema.json",
  "expect": "valid",
  "instance": {
    "cd_schema": "cd.config.project/0",
    "project": {
      "name": "shop-demo",
      "root": "D:/private/shop-demo"
    },
    "endpoints": [
      {
        "id": "local-ollama",
        "kind": "openai_compatible",
        "base_url": "http://127.0.0.1:11434/v1",
        "local": true,
        "max_concurrency": 1
      },
      {
        "id": "deepseek",
        "kind": "openai_compatible",
        "base_url": "https://api.deepseek.com/v1",
        "api_key_env": "DEEPSEEK_API_KEY",
        "local": false,
        "max_data_class": "confidential",
        "max_concurrency": 8
      },
      {
        "id": "claude",
        "kind": "anthropic",
        "base_url": "https://api.anthropic.com",
        "api_key_env": "ANTHROPIC_API_KEY",
        "local": false
      }
    ],
    "agents": [
      {
        "id": "head-logic",
        "role": "head_logic",
        "endpoint": "claude",
        "model": "claude-opus-5-5"
      },
      {
        "id": "head-dispatch",
        "role": "head_dispatch",
        "endpoint": "deepseek",
        "model": "deepseek-chat"
      },
      {
        "id": "worker-1",
        "role": "worker",
        "endpoint": "local-ollama",
        "model": "qwen3:8b"
      },
      {
        "id": "guardian-1",
        "role": "guardian",
        "endpoint": "local-ollama",
        "model": "qwen3:8b"
      }
    ],
    "permissions": {
      "run_command": "allowlist",
      "command_allowlist": [
        "git log",
        "git diff",
        "pytest"
      ],
      "write_files": false
    },
    "defaults": {
      "budget": {
        "max_steps": 60,
        "max_tokens": 400000
      },
      "stall_steps": 6
    }
  }
}
