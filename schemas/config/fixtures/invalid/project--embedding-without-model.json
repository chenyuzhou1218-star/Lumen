  "expect": "invalid",
  "expect_error": { "validator": "required", "message_contains": "model" },
  "instance": {
    "cd_schema": "cd.config.project/0",
    "project": { "name": "shop-demo", "root": "D:/private/shop-demo" },
    "endpoints": [
      { "id": "local-ollama", "kind": "openai_compatible", "base_url": "http://127.0.0.1:11434/v1", "local": true }
    ],
    "agents": [
      { "id": "doctor", "role": "general", "endpoint": "local-ollama", "model": "qwen3:4b" }
    ],
    "memory": { "embedding": { "endpoint": "local-ollama" } }
  }
}
