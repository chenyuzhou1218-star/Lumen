{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-doctor.local/schemas/v0/evidence/validation-result.schema.json",
  "title": "Claim evidence validation result v0",
  "description": "Output of the evidence validator for one claim. Each cited item is checked at four levels: exists (record is in the registry), integrity (stored bytes still hash to content.sha256), binding (record's code version / trace / action match the claim scope and the ref's expect_binding), support (the item really shows what is claimed: predicates evaluated, or an independent reviewer confirmed). An id merely existing is never enough.",
  "type": "object",
  "required": ["cd_schema", "id", "claim_id", "validated_at", "validator", "refs", "overall"],
  "properties": {
    "cd_schema": { "const": "cd.evidence.validation/0" },
    "id": { "type": "string", "pattern": "^val_[0-9A-HJKMNP-TV-Z]{26}$" },
    "code_version": {
      "description": "Code version current when the validation ran.",
      "$ref": "../common/defs.schema.json#/$defs/codeVersion"
    },
    "claim_id": { "type": "string", "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$" },
    "validated_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp" },
    "validator": { "type": "string", "pattern": "^[a-z0-9_.-]+/[0-9][0-9A-Za-z.+-]*$" },
    "refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/refResult" }
    },
    "overall": {
      "description": "accepted: every cited item passed levels 1-3 and every 'supports' item has verified support. accepted_support_unverified: levels 1-3 passed but at least one 'supports' item could not be checked; the claim may be shown but not treated as established. rejected: something cited is missing, tampered, bound to the wrong version/event, or contradicts the claim.",
      "enum": ["accepted", "accepted_support_unverified", "rejected"]
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Any failure at levels 1-3, or any contradicted supporting item, rejects the claim.",
      "if": {
        "properties": {
          "refs": {
            "contains": {
              "anyOf": [
                { "properties": { "exists": { "const": "fail" } } },
                { "properties": { "integrity": { "const": "fail" } } },
                { "properties": { "binding": { "const": "fail" } } },
                { "properties": { "role": { "const": "supports" }, "support": { "const": "contradicted" } } }
              ]
            }
          }
        }
      },
      "then": { "properties": { "overall": { "const": "rejected" } } }
    },
    {
      "description": "Both accepted outcomes need levels 1-3 to have run and passed for every item: existence and integrity pass, binding pass or not_checked (nothing to bind). Only the support level may remain unverified, and only in accepted_support_unverified.",
      "if": { "required": ["overall"], "properties": { "overall": { "enum": ["accepted", "accepted_support_unverified"] } } },
      "then": {
        "properties": {
          "refs": {
            "items": {
              "properties": {
                "exists": { "const": "pass" },
                "integrity": { "const": "pass" },
                "binding": { "enum": ["pass", "not_checked"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "overall": { "const": "accepted" } } },
      "then": {
        "properties": {
          "refs": {
            "items": {
              "if": { "properties": { "role": { "const": "supports" } } },
              "then": { "properties": { "support": { "enum": ["machine_verified", "independently_verified"] } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "refResult": {
      "type": "object",
      "required": ["id", "role", "exists", "integrity", "binding", "support"],
      "properties": {
        "id": { "type": "string", "maxLength": 2048 },
        "role": { "enum": ["supports", "refutes", "context"] },
        "exists": { "enum": ["pass", "fail"] },
        "integrity": { "enum": ["pass", "fail", "skipped"] },
        "binding": {
          "description": "not_checked only when neither the claim scope nor expect_binding constrains anything this evidence kind is bound to.",
          "enum": ["pass", "fail", "not_checked", "skipped"]
        },
        "binding_mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "expected", "actual"],
            "properties": {
              "field": { "enum": ["code_version", "config_version", "db_schema_version", "trace_id", "action_id", "services", "environment"] },
              "expected": { "type": "string" },
              "actual": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "support": {
          "enum": ["machine_verified", "independently_verified", "unverified", "contradicted", "inapplicable", "skipped"]
        },
        "predicate_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "result"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "result": { "enum": ["true", "false", "inapplicable", "error"] },
              "detail": { "type": "string", "maxLength": 1024 }
            },
            "additionalProperties": false
          }
        },
        "verified_by": {
          "description": "For independently_verified: the review that confirmed it and the reviewer (an agent or the user), which must differ from the claim author.",
          "type": "object",
          "required": ["agent_id", "review_id"],
          "properties": {
            "agent_id": { "$ref": "../agent/defs.schema.json#/$defs/participant" },
            "review_id": { "$ref": "../agent/defs.schema.json#/$defs/reviewId" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Later levels are skipped once an earlier level fails.",
          "if": { "properties": { "exists": { "const": "fail" } } },
          "then": { "properties": { "integrity": { "const": "skipped" }, "binding": { "const": "skipped" }, "support": { "const": "skipped" } } }
        },
        {
          "if": { "properties": { "exists": { "const": "pass" } } },
          "then": { "properties": { "integrity": { "enum": ["pass", "fail"] } } }
        },
        {
          "if": { "properties": { "integrity": { "const": "fail" } } },
          "then": { "properties": { "binding": { "const": "skipped" }, "support": { "const": "skipped" } } }
        },
        {
          "if": { "properties": { "binding": { "const": "fail" } } },
          "then": { "required": ["binding_mismatches"], "properties": { "binding_mismatches": { "minItems": 1 }, "support": { "const": "skipped" } } }
        },
        {
          "if": { "properties": { "support": { "const": "machine_verified" } } },
          "then": {
            "required": ["predicate_results"],
            "properties": { "predicate_results": { "minItems": 1, "items": { "properties": { "result": { "const": "true" } } } } }
          }
        },
        {
          "if": { "properties": { "support": { "const": "contradicted" } } },
          "then": {
            "required": ["predicate_results"],
            "properties": { "predicate_results": { "contains": { "properties": { "result": { "const": "false" } } } } }
          }
        },
        {
          "if": { "properties": { "support": { "const": "independently_verified" } } },
          "then": { "required": ["verified_by"] }
        }
      ]
    }
  }
}
